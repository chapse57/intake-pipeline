# WF-1 intake webhook (n8n Production URL)
N8N_INTAKE_WEBHOOK_URL=https://<n8n-host>/webhook/intake

# WF-3 DocuSign Connect receiver. Optional: without it, T8-T10 skip.
N8N_DOCUSIGN_WEBHOOK_URL=https://<n8n-host>/webhook/docusign-complete

# Notion internal integration token, shared with all three databases
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# Database ids (not data source ids) — the REST API v2022-06-28 takes these
NOTION_CANDIDATES_DB=4046c961-05ea-4b46-9edd-df3d152cb1b2
NOTION_RECRUITERS_DB=f515ee08-573f-4b05-bae1-d73892278d8f
NOTION_EVENTS_DB=ec414c5e-2999-4730-82f2-a0522fe09a89

# DocuSign sandbox template ids, one per role. T8 checks the Closer one.
DOCUSIGN_TEMPLATE_SETTER=
DOCUSIGN_TEMPLATE_COACH=
DOCUSIGN_TEMPLATE_CLOSER=
DOCUSIGN_TEMPLATE_FULL_CYCLE=

# T10 fault-injection seam. WF-3 routes Xero calls to a 500-returning stub
# when the candidate's email domain matches. Leave both blank in any
# deployment that is not being tested; T10 skips itself when unset.
XERO_FAULT_DOMAIN=
XERO_FAULT_URL=

# ---- warehouse tier (pytest -m warehouse). Three identities, no shared one.
# Local PostgreSQL: warehouse/local_dev.sh writes .env.warehouse.local with these.
WAREHOUSE_ADMIN_DSN=
WAREHOUSE_LOADER_DSN=
WAREHOUSE_ANALYST_DSN=
# Azure: no passwords anywhere. WAREHOUSE_AUTH=entra turns the DSNs' missing
# password into an Entra access token; the two service principals read their
# client secret from Key Vault at connect time. provision.sh env prints these.
#WAREHOUSE_AUTH=entra
#AZURE_TENANT_ID=
#WAREHOUSE_LOADER_CLIENT_ID=
#WAREHOUSE_LOADER_SECRET_ID=https://<vault>.vault.azure.net/secrets/intake-wh-loader-client-secret
#WAREHOUSE_ANALYST_CLIENT_ID=
#WAREHOUSE_ANALYST_SECRET_ID=https://<vault>.vault.azure.net/secrets/intake-wh-analyst-client-secret
